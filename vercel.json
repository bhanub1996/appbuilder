{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { 
      "src": "/api/(.*)", 
      "dest": "/api/index.py", 
      "headers": { 
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0" 
      } 
    },
    { "src": "/(.*)", "dest": "/frontend/$1", "check": true },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ],
  "crons": [
    { "path": "/api/internal/cron/expire-elevations", "schedule": "0 0 * * *" },
    { "path": "/api/internal/cron/reconcile-index", "schedule": "0 2 * * *" }
  ]
}

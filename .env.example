# ---------------------------------------------------------------------------
# Copy to .env for local dev. In production set these in the Vercel dashboard
# (Project -> Settings -> Environment Variables). Shared across both services.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_ENV=development
# openssl rand -hex 32
JWT_SECRET=change-me-32-bytes-minimum-please-rotate
JWT_ISSUER=ztdev
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=28800

# --- Postgres (Neon / Supabase). MUST be the POOLED connection string. -----
# Serverless functions open a connection per invocation; unpooled will exhaust.
DATABASE_URL=
# Leave DATABASE_URL empty to boot with the in-memory demo store instead.

# --- Redis (Upstash REST - HTTP based, works from serverless) ---------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- BYOK vault -------------------------------------------------------------
# Key-encryption key. openssl rand -base64 32
VAULT_KEK=

# --- GitHub App -------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
# Paste the full PEM with literal \n escapes, or base64 the PEM and use _B64.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE=https://api.github.com

# --- Off-Vercel compute (see docs/DEPLOYMENT.md section 3) ------------------
# OpenAI-compatible endpoint for the local triage/validator model (vLLM).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=qwen2.5-coder-32b-instruct
# Indexer worker: long-running tree-sitter service. Vercel cannot host this.
INDEXER_BASE_URL=
INDEXER_SHARED_SECRET=

# --- Cron protection --------------------------------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron paths.
CRON_SECRET=

# --- Frontend (build-time, embedded in the browser bundle - no secrets) -----
VITE_API_BASE=/api
